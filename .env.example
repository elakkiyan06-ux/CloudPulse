# ==============================================================================
# CloudPulse — Managed Database Performance Intelligence Platform
# Environment Configuration
# ==============================================================================

# Database Connection (AWS RDS PostgreSQL or Local PostgreSQL)
# Example AWS RDS URL:
# DATABASE_URL=postgresql+psycopg2://cloudpulse_admin:SuperSecurePass123!@cloudpulse-rds-db.c9m2x8abcxyz.ap-south-1.rds.amazonaws.com:5432/cloudpulse_prod
#
# Example Local Docker / Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cloudpulse_local
#
# Fallback (Auto-detected if DATABASE_URL is unset):
# SQLite local development file: sqlite:///./cloudpulse.db
DATABASE_URL=sqlite:///./cloudpulse.db

# AWS CloudWatch & RDS Configuration
AWS_REGION=ap-south-1
AWS_RDS_IDENTIFIER=cloudpulse-rds-db
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Open-Meteo Real-Time Telemetry API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Platform Engine Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8080
